# Copy to /etc/systemd/system/ecc-sheet.service and adjust User/Group/WorkingDirectory
# if you deploy somewhere other than /opt/ecc-sheet.

[Unit]
Description=ECC Sheet Gunicorn service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=eccsheet
Group=eccsheet
WorkingDirectory=/opt/ecc-sheet
EnvironmentFile=/opt/ecc-sheet/.env
Environment=PYTHONUNBUFFERED=1

# Keep the database schema and seeded defaults in sync on every restart.
ExecStartPre=/opt/ecc-sheet/.venv/bin/flask --app backend.app db upgrade
ExecStartPre=/opt/ecc-sheet/.venv/bin/python -c "from backend.app import init_db; init_db()"
ExecStart=/opt/ecc-sheet/.venv/bin/gunicorn --workers 2 --bind 127.0.0.1:5000 backend.app:app

Restart=on-failure
RestartSec=5
TimeoutStartSec=120
KillSignal=SIGTERM

[Install]
WantedBy=multi-user.target
