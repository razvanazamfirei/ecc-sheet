[Unit]
Description=ECC Sheet - Medical Shift Tracking
After=network.target
Documentation=https://github.com/razvanazamfirei/ecc-sheet

[Service]
Type=simple
User=eccsheet
Group=eccsheet
WorkingDirectory=/opt/ecc-sheet

EnvironmentFile=/opt/ecc-sheet/.env
Environment=FLASK_APP=backend.app
Environment=PATH=/opt/ecc-sheet/.venv/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

# Bootstrap schema and seed data on every start so upgrades apply automatically.
ExecStartPre=/opt/ecc-sheet/.venv/bin/flask --app backend.app bootstrap-application

ExecStart=/opt/ecc-sheet/.venv/bin/gunicorn \
    --workers 2 \
    --bind 127.0.0.1:5000 \
    --access-logfile - \
    --error-logfile - \
    backend.app:app

Restart=on-failure
RestartSec=5

# Hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/opt/ecc-sheet/instance /opt/ecc-sheet/logs

[Install]
WantedBy=multi-user.target
