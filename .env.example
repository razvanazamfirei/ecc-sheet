# ECC Sheet Environment Configuration Template
# Copy this file to .env and fill in your values

# ==============================================================================
# REQUIRED SETTINGS
# ==============================================================================

# Secret key for Flask session management and CSRF protection
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-secret-key-here-generate-a-strong-random-key

# Database configuration
# For SQLite (default): sqlite:///ecc_sheet.db
# For PostgreSQL: postgresql://user:password@localhost/ecc_sheet
DATABASE_URL=sqlite:///ecc_sheet.db

# Current user name (used for audit logging and lock tracking)
# This should be set by your authentication system
USER_NAME=Admin

# Admin users (comma-separated list of usernames)
# Users in this list have access to admin features:
# - Resident management
# - Role configuration
# - Holiday management
# - Audit log viewing
# - Email reporting
ADMIN_USERS="Admin,John Doe,Jane Smith"

# ==============================================================================
# EMAIL CONFIGURATION (REQUIRED FOR REPORTS)
# ==============================================================================

# SMTP server settings for sending email reports
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USERNAME=user@example.com
EMAIL_PASSWORD=your-app-password

# Default recipient for email reports
# Users can override this when sending individual reports
EMAIL_RECIPIENT=recipient@example.com

# ==============================================================================
# PAYROLL EXPORT SETTINGS (used to seed the database on first run)
# These values initialize the PayrollSettings table. After first run, edit
# them through the Payroll Settings page in the admin UI.
# ==============================================================================

PAYROLL_ACCT_UNIT=
PAYROLL_ADMIN_USERS=
PAYROLL_BATCH=
PAYROLL_COMPANY=
PAYROLL_DEPT=
PAYROLL_EXPENSE=
PAYROLL_LABEL_SUFFIX=
PAYROLL_PAY_CODE=
PAYROLL_PROGRAM=

# ==============================================================================
# OPTIONAL SETTINGS
# ==============================================================================

# Application timezone (default: America/New_York)
# Used for date/time calculations and display
# See: https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
TIMEZONE=America/New_York

# Flask environment (development or production)
# Set to 'production' for deployed environments
FLASK_ENV=development

# Application port (default: 5000)
PORT=5000

# Flask debug mode (true or false)
# IMPORTANT: Set to 'false' in production!
DEBUG=true

# ==============================================================================
# AMION INTEGRATION (OPTIONAL)
# ==============================================================================

# Amion schedule code (unique identifier for your institution)
# This is used for both schedule imports (Report 619) and staff list imports (Report 706)
# Contact Amion support to get your institution's schedule code
AMION_SCHEDULE_CODE=your-schedule-code-here

# ==============================================================================
# LOGGING (OPTIONAL)
# ==============================================================================

# Log level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# Log file path (leave empty to log to console only)
# LOG_FILE=logs/ecc_sheet.log

# ==============================================================================
# SECURITY HEADERS (RECOMMENDED FOR PRODUCTION)
# ==============================================================================

# Content Security Policy
# CSP_POLICY=default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline';

# Session cookie settings
# SESSION_COOKIE_SECURE=true
# SESSION_COOKIE_HTTPONLY=true
# SESSION_COOKIE_SAMESITE=Lax

# Permanent session lifetime in seconds (default: 31 days)
# PERMANENT_SESSION_LIFETIME=2678400

# ==============================================================================
# NOTES
# ==============================================================================

# 1. Never commit the .env file to version control
# 2. Keep SECRET_KEY secure and unique per environment
# 3. Set DEBUG=false in production
# 4. Use strong, unique values for production deployments
# 5. Update ADMIN_USERS to match your institution's admin users
# 6. Configure external authentication (SSO, reverse proxy) for production
# 7. Consider using PostgreSQL instead of SQLite for production
# 8. Email settings are required for report email functionality
# 9. Time rounding is set to 5-minute increments (always rounds up)
