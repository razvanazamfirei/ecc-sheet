{
  "name": "ecc-sheet",
  "version": "1.0.0",
  "description": "ECC Sheet automation with Flask backend and vanilla JavaScript frontend",
  "private": true,
  "type": "module",
  "scripts": {
    "format:js": "prettier --write \"frontend/static/js/**/*.js\"",
    "format:css": "prettier --write \"frontend/static/css/**/*.css\"",
    "format:html": "prettier --write \"frontend/templates/**/*.html\"",
    "lint:css": "stylelint \"frontend/static/css/**/*.css\"",
    "format": "bun run format:js && bun run format:css && bun run format:html",
    "format:check": "prettier --check \"frontend/**/*.{js,css,html}\"",
    "build": "vite build",
    "dev": "vite build --watch",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test:coverage": "node --experimental-vm-modules node_modules/jest/bin/jest.js --coverage"
  },
  "devDependencies": {
    "jest": "^30.3.0",
    "jest-junit": "^16.0.0",
    "prettier": "^3.8.1",
    "prettier-plugin-jinja-template": "^2.1.0",
    "stylelint": "^17.4.0",
    "stylelint-config-standard": "^40.0.0",
    "vite": "^7.3.1"
  },
  "dependencies": {
    "@codecov/vite-plugin": "^1.9.1",
    "bootstrap": "^5.3.8",
    "bootstrap-icons": "^1.13.1",
    "luxon": "^3.7.2"
  }
}
