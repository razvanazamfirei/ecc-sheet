{
    "printWidth": 120,
    "tabWidth": 4,
    "useTabs": false,
    "semi": true,
    "singleQuote": false,
    "trailingComma": "es5",
    "bracketSpacing": true,
    "arrowParens": "always",
    "endOfLine": "lf",
    "plugins": ["prettier-plugin-jinja-template"],
    "overrides": [
        {
            "files": "*.html",
            "options": {
                "parser": "jinja-template",
                "printWidth": 120,
                "tabWidth": 4
            }
        },
        {
            "files": "*.css",
            "options": {
                "tabWidth": 4
            }
        },
        {
            "files": "*.js",
            "options": {
                "tabWidth": 4
            }
        }
    ]
}
